# ============================================
# PrintRobot Development Environment (.env.local)
# ============================================
# FOR LOCAL DEVELOPMENT ONLY
# Copy this file to .env.local and adjust values
# Never commit .env.local to Git (it's in .gitignore)
#
# For production: use .env.production.example as reference

# ============================================
# BACKEND (FastAPI)
# ============================================

# Database URL - local SQLite (dev only)
DATABASE_URL=sqlite:///./data/fabrik.db

# JWT - Use a random key (min 32 chars). Change in production!
JWT_SECRET=dev-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Moonraker Integration
MOONRAKER_TIMEOUT=10

# Logging - verbose in development
LOG_LEVEL=debug

# CORS - Allow localhost frontend
CORS_ORIGINS=http://localhost:5173

# ============================================
# FRONTEND (SvelteKit)
# ============================================

# Backend URL from browser (localhost in dev)
VITE_API_URL=http://localhost:8000
VITE_API_WS_URL=ws://localhost:8000/ws

# Public API path (used in server-side code)
PUBLIC_API_URL=/api

# ============================================
# ENVIRONMENT
# ============================================

NODE_ENV=development
ENVIRONMENT=development
