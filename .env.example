# ============================================
# PrintRobot .env Configuration
# ============================================
# Copy this file to .env.local (dev) or .env.production (prod)
# DO NOT commit actual .env files with secrets to Git

# ============================================
# BACKEND (FastAPI)
# ============================================

# Database URL (SQLite for MVP, PostgreSQL for production later)
DATABASE_URL=sqlite:///./data/fabrik.db

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Moonraker Integration
MOONRAKER_TIMEOUT=10

# Logging
LOG_LEVEL=debug

# CORS (Allowed origins for frontend)
CORS_ORIGINS=http://localhost:5173

# ============================================
# FRONTEND (SvelteKit)
# ============================================

# API URL (where backend is hosted)
VITE_API_URL=http://localhost:8000
VITE_API_WS_URL=ws://localhost:8000/ws

# Public API prefix (for SvelteKit server hooks)
PUBLIC_API_URL=/api

# ============================================
# ENVIRONMENT
# ============================================

NODE_ENV=development
ENVIRONMENT=development
