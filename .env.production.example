# ============================================
# PrintRobot Production Environment (.env.production)
# ============================================
# FOR PRODUCTION DOCKER DEPLOYMENT
# Copy to .env.production and CHANGE ALL SECRETS
# ⚠️  NEVER commit .env.production to Git
# ⚠️  Store secrets in: 1password, Vault, AWS Secrets Manager, etc.
#
# For development: use .env.local (from .env.example)

# ============================================
# BACKEND (FastAPI)
# ============================================

# Database URL - can upgrade to PostgreSQL
DATABASE_URL=sqlite:///./data/fabrik.db

# JWT Secret - GENERATE A NEW ONE! (min 32 random chars)
# $ openssl rand -hex 16
JWT_SECRET=CHANGE-THIS-TO-A-SUPER-SECRET-RANDOM-KEY-MIN-32-CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Moonraker Integration
MOONRAKER_TIMEOUT=10

# Logging - less verbose in production
LOG_LEVEL=info

# CORS - Allow production domain (change to YOUR domain)
CORS_ORIGINS=https://printrobot.lab.edu

# ============================================
# FRONTEND (SvelteKit)
# ============================================

# Backend URL - production domain with HTTPS (for browser access)
VITE_API_URL=https://printrobot.lab.edu/api
VITE_API_WS_URL=wss://printrobot.lab.edu/ws

# Public API path (same for prod)
PUBLIC_API_URL=/api

# ============================================
# ENVIRONMENT
# ============================================

NODE_ENV=production
ENVIRONMENT=production
