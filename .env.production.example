# ============================================
# PrintRobot Production Environment
# ============================================
# WARNING: This file should NOT be committed to Git!
# Use .env.production for production deployments
# Keep secrets in a secure location (e.g., 1password, Vault, Secrets Manager)

# Backend (FastAPI)
DATABASE_URL=sqlite:///./data/fabrik.db
JWT_SECRET=change-this-to-a-super-secret-random-key-min-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
MOONRAKER_TIMEOUT=10
LOG_LEVEL=info
CORS_ORIGINS=https://printrobot.lab.edu

# Frontend (SvelteKit)
VITE_API_URL=https://printrobot.lab.edu/api
VITE_API_WS_URL=wss://printrobot.lab.edu/ws
PUBLIC_API_URL=/api

# Environment
NODE_ENV=production
ENVIRONMENT=production
